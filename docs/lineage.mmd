flowchart LR
    subgraph RAW["data/raw/ (read only)"]
        O1[orders_2026_01.csv]
        O2[orders_2026_02.csv]
        O3["orders_2026_03.csv<br/>(prices in cents)"]
        C[customers.csv]
    end

    L["1 · load_raw()<br/>read as text<br/>+ source_file"]
    CO["2a · clean_orders()<br/>drop exact duplicates · trim<br/>parse mixed dates · to numbers<br/>March cents ÷ 100"]
    CC["2b · clean_customers()<br/>trim · documented fixes<br/>(C007 country, C003 email)"]
    V{"3 · validate()<br/>rules.py (pandera)"}
    STOP["STOP<br/>exit 1 · nothing written<br/>log = FAILED"]
    S["4 · split()<br/>row-level checks + reason"]
    E["5 · enrich_orders()<br/>+ city · + line_total"]
    OUT["6 · output()"]

    O1 & O2 & O3 --> L
    C --> L
    L --> CO
    L --> CC
    CO --> V
    CC --> V
    V -- critical rule fails --> STOP
    V -- all rules pass --> S
    CC -. customer list .-> S
    S -- trusted --> E
    CC -. city .-> E
    E --> OUT

    subgraph OUTPUTS["data/output/"]
        F[fct_orders.csv]
        Q[quarantine_orders.csv]
        RC[revenue_by_city.csv]
        RK["revenue_by_category.csv<br/>(new)"]
    end
    S -- quarantined + reason --> Q
    OUT --> F & RC & RK
    OUT -. appends .-> LOG[logs/run_log.txt]
    STOP -. appends .-> LOG

    classDef raw fill:#eef2f7,stroke:#5b6b7f;
    classDef step fill:#ffffff,stroke:#2b5797;
    classDef bad fill:#fde8e8,stroke:#c0392b;
    classDef out fill:#e8f5e9,stroke:#2e7d32;
    classDef new fill:#fff4d6,stroke:#c98a00;
    class O1,O2,O3,C raw;
    class L,CO,CC,S,E,OUT,V step;
    class STOP,Q bad;
    class F,RC out;
    class RK new;
